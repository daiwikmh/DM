# Postgres — works with local, Neon, or Supabase unchanged
DATABASE_URL=postgres://postgres:postgres@localhost:5432/prava

# Resolution pipeline — identify() runs on NVIDIA NIM (moonshotai/kimi-k2.6, multimodal)
NVIDIA_API_KEY=
# ANTHROPIC_API_KEY is currently unused by the worker (identify.ts moved off Claude);
# keep it here only if something in this project ends up needing a direct Claude call.
ANTHROPIC_API_KEY=

# Product search — SerpAPI's Google Shopping engine is what the resolver calls.
# Key from serpapi.com/manage-api-key.
SERPAPI_API_KEY=

# Shopify Catalog MCP — the intended search backend, unused while its client
# credentials are unavailable. catalog.ts stays in place behind serpapi.ts.
SHOPIFY_CATALOG_CLIENT_ID=
SHOPIFY_CATALOG_CLIENT_SECRET=
UCP_AGENT_PROFILE_URL=

# Prava — self-serve at dashboard.prava.space, sandbox keys work instantly, no waiting.
PRAVA_SECRET_KEY=
PRAVA_PUBLISHABLE_KEY=
PRAVA_API_BASE_URL=https://sandbox.api.prava.space

# Rye — universal checkout execution layer (places the actual merchant order)
RYE_API_KEY=

# Meta intake (Phase 3)
META_APP_SECRET=
META_VERIFY_TOKEN=
IG_PAGE_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Web
PUBLIC_SITE_URL=http://localhost:4321
SESSION_SECRET=
