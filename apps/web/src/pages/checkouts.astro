---
import DashboardShell from '../layouts/DashboardShell.astro';
import { db, checkouts, items } from '@prava/db';
import { desc, eq } from 'drizzle-orm';

const { userId } = Astro.locals;
if (!userId) return Astro.redirect('/');

const rows = await db
  .select({ checkout: checkouts, item: items })
  .from(checkouts)
  .innerJoin(items, eq(checkouts.itemId, items.id))
  .where(eq(checkouts.userId, userId))
  .orderBy(desc(checkouts.createdAt))
  .limit(50);

const LABEL: Record<string, string> = {
  authorizing: 'Awaiting passkey',
  authorized: 'Card minted',
  placed: 'Order placed',
  declined: 'Declined by merchant',
  failed: 'Could not complete',
};

const TONE: Record<string, string> = {
  authorizing: 'bg-stone-100 text-stone-700',
  authorized: 'bg-blue-100 text-blue-900',
  placed: 'bg-green-100 text-green-900',
  declined: 'bg-amber-100 text-amber-900',
  failed: 'bg-red-100 text-red-900',
};

const money = (amount: string | null, currency: string | null) =>
  amount && currency
    ? new Intl.NumberFormat('en', { style: 'currency', currency }).format(Number(amount))
    : null;
---

<DashboardShell title="Checkouts" active="checkouts">
  <header class="mb-6">
    <h1 class="text-2xl font-semibold tracking-tight">Checkouts</h1>
  </header>

  {
    rows.length === 0 ? (
      <div class="rounded-xl border border-dashed border-stone-300 p-10 text-center">
        <p class="font-medium">No checkouts yet</p>
        <p class="mt-1 text-sm text-stone-500">
          Pay with Prava on one of your finds and it will show up here.
        </p>
      </div>
    ) : (
      <ul class="space-y-3">
        {rows.map(({ checkout, item }) => (
          <li class="rounded-xl border border-stone-200 bg-white p-4">
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <p class="truncate font-medium">{item.title}</p>
                <p class="mt-1 text-sm text-stone-500">
                  {item.merchant}
                  {money(checkout.totalAmount, checkout.currency) && (
                    <span class="text-stone-900">
                      {' '}
                      · {money(checkout.totalAmount, checkout.currency)}
                    </span>
                  )}
                </p>
              </div>

              <span
                class={`shrink-0 rounded-full px-2.5 py-1 text-xs font-medium ${TONE[checkout.status]}`}
              >
                {LABEL[checkout.status]}
              </span>
            </div>

            {checkout.outcome && <p class="mt-2 text-xs text-stone-500">{checkout.outcome}</p>}

            <p class="mt-2 font-mono text-xs text-stone-400">
              {checkout.orderId ?? checkout.sessionId}
            </p>
          </li>
        ))}
      </ul>
    )
  }
</DashboardShell>
