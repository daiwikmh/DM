---
import DashboardShell from '../layouts/DashboardShell.astro';
import ItemGrid from '../components/ItemGrid.astro';

const { userId } = Astro.locals;
if (!userId) return Astro.redirect('/');
---

<DashboardShell title="Your finds" active="finds">
  <header class="mb-10">
    <p class="text-[11px] font-medium tracking-[-0.02em] text-white/40 uppercase sm:text-[13px]">
      Reel to product
    </p>
    <h1 class="mt-3 text-[44px] leading-[0.9] font-medium tracking-[-0.04em] sm:text-[64px]">
      Your finds
    </h1>
  </header>

  <ItemGrid server:defer userId={userId}>
    <div slot="fallback" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        Array.from({ length: 3 }).map(() => (
          <div class="h-80 animate-pulse border border-white/10 bg-white/[0.03]" />
        ))
      }
    </div>
  </ItemGrid>
</DashboardShell>
