---
import Base from '../layouts/Base.astro';
import ItemGrid from '../components/ItemGrid.astro';

const { userId } = Astro.locals;
if (!userId) return Astro.redirect('/');
---

<Base title="Your finds">
  <header class="mb-6 flex items-baseline justify-between">
    <h1 class="text-2xl font-semibold tracking-tight">Your finds</h1>
    <a href="/logout" class="text-sm text-stone-500 hover:text-stone-900">Sign out</a>
  </header>

  {/*
    Server island: the shell above is cacheable chrome, the grid is a
    per-request fragment. Keeps personalised data out of any page cache.
  */}
  <ItemGrid server:defer userId={userId}>
    <div slot="fallback" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        Array.from({ length: 3 }).map(() => (
          <div class="h-72 animate-pulse rounded-xl border border-stone-200 bg-white" />
        ))
      }
    </div>
  </ItemGrid>
</Base>
