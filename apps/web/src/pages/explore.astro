---
import DashboardShell from '../layouts/DashboardShell.astro';
import { searchByText, type CatalogCandidate } from '@prava/worker/resolver/catalog';

const { userId } = Astro.locals;
if (!userId) return Astro.redirect('/');

const query = Astro.url.searchParams.get('q')?.trim() ?? '';

let candidates: CatalogCandidate[] = [];
let error: string | null = null;

if (query) {
  try {
    candidates = await searchByText(query);
  } catch (err) {
    error = err instanceof Error ? err.message : 'Search failed';
  }
}

const price = (c: CatalogCandidate) =>
  c.priceAmount && c.currency
    ? new Intl.NumberFormat('en', { style: 'currency', currency: c.currency }).format(Number(c.priceAmount))
    : null;
---

<DashboardShell title="Explore" active="explore">
  <header class="mb-8">
    <p class="text-[11px] font-medium tracking-[-0.02em] text-white/40 uppercase sm:text-[13px]">
      Shopify catalog, no reel required
    </p>
    <h1 class="mt-3 text-[44px] leading-[0.9] font-medium tracking-[-0.04em] sm:text-[64px]">
      Explore
    </h1>
  </header>

  <form method="GET" class="mb-10 flex gap-3">
    <input
      type="text"
      name="q"
      value={query}
      placeholder="wireless headphones under $100"
      class="w-full rounded-full border border-white/20 bg-transparent px-5 py-3 text-[15px] tracking-[-0.02em] text-white placeholder:text-white/30 focus:border-white focus:outline-none"
    />
    <button
      type="submit"
      class="shrink-0 rounded-full bg-white px-6 py-3 text-[15px] font-medium tracking-[-0.02em] text-black transition-transform hover:scale-[1.02]"
    >
      Search
    </button>
  </form>

  {
    error && (
      <div class="border border-red-500/30 bg-red-500/10 p-5 text-[13px] text-red-300">{error}</div>
    )
  }

  {
    !error && query && candidates.length === 0 && (
      <div class="border border-dashed border-white/15 px-6 py-16 text-center">
        <p class="text-[20px] font-medium tracking-[-0.04em] sm:text-[30px]">No matches</p>
        <p class="mt-3 text-[13px] text-white/40 sm:text-[15px]">Try a different query.</p>
      </div>
    )
  }

  {
    candidates.length > 0 && (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {candidates.map((c) => (
          <article class="border border-white/10 bg-white/[0.03]">
            {c.imageUrl && (
              <img
                src={c.imageUrl}
                alt={c.title}
                loading="lazy"
                class="aspect-square w-full bg-white/5 object-cover"
              />
            )}
            <div class="p-5">
              <h3 class="text-[20px] leading-[1.05] font-medium tracking-[-0.04em]">{c.title}</h3>
              <p class="mt-2 text-[13px] tracking-[-0.02em] text-white/40 uppercase">{c.merchant}</p>
              {price(c) && (
                <p class="mt-3 text-[36px] leading-none font-medium tracking-[-0.04em]">{price(c)}</p>
              )}
              <a
                href={c.productUrl}
                target="_blank"
                rel="noopener nofollow"
                class="mt-5 block rounded-full bg-white px-5 py-3 text-center text-[15px] font-medium tracking-[-0.02em] text-black transition-transform hover:scale-[1.02]"
              >
                View at {c.merchant ?? 'merchant'}
              </a>
            </div>
          </article>
        ))}
      </div>
    )
  }
</DashboardShell>
