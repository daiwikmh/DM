---
import DashboardShell from '../layouts/DashboardShell.astro';
import { searchByText, type CatalogCandidate } from '@prava/worker/resolver/catalog';

const { userId } = Astro.locals;
if (!userId) return Astro.redirect('/');

const query = Astro.url.searchParams.get('q')?.trim() ?? '';

let candidates: CatalogCandidate[] = [];
let error: string | null = null;

if (query) {
  try {
    candidates = await searchByText(query);
  } catch (err) {
    error = err instanceof Error ? err.message : 'Search failed';
  }
}

const price = (c: CatalogCandidate) =>
  c.priceAmount && c.currency
    ? new Intl.NumberFormat('en', { style: 'currency', currency: c.currency }).format(Number(c.priceAmount))
    : null;
---

<DashboardShell title="Explore" active="explore">
  <header class="mb-6">
    <h1 class="text-2xl font-semibold tracking-tight">Explore</h1>
    <p class="mt-1 text-sm text-stone-500">Search the Shopify Catalog directly, without going through a reel.</p>
  </header>

  <form method="GET" class="mb-8 flex gap-2">
    <input
      type="text"
      name="q"
      value={query}
      placeholder="wireless headphones under $100"
      class="w-full rounded-lg border border-stone-300 px-3 py-2 text-sm focus:border-stone-500 focus:outline-none"
    />
    <button type="submit" class="shrink-0 rounded-lg bg-stone-900 px-4 py-2 text-sm font-medium text-white hover:bg-stone-700">
      Search
    </button>
  </form>

  {
    error && (
      <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">{error}</div>
    )
  }

  {
    !error && query && candidates.length === 0 && (
      <div class="rounded-xl border border-dashed border-stone-300 p-10 text-center">
        <p class="font-medium">No matches</p>
        <p class="mt-1 text-sm text-stone-500">Try a different query.</p>
      </div>
    )
  }

  {
    candidates.length > 0 && (
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {candidates.map((c) => (
          <article class="overflow-hidden rounded-xl border border-stone-200 bg-white">
            {c.imageUrl && (
              <img src={c.imageUrl} alt={c.title} loading="lazy" class="aspect-square w-full bg-stone-100 object-cover" />
            )}
            <div class="p-4">
              <h3 class="leading-snug font-medium">{c.title}</h3>
              <p class="mt-1 text-sm text-stone-500">
                {c.merchant}
                {price(c) && <span class="text-stone-900"> · {price(c)}</span>}
              </p>
              <a
                href={c.productUrl}
                target="_blank"
                rel="noopener nofollow"
                class="mt-3 block rounded-lg bg-stone-900 px-4 py-2 text-center text-sm font-medium text-white hover:bg-stone-700"
              >
                View at {c.merchant ?? 'merchant'}
              </a>
            </div>
          </article>
        ))}
      </div>
    )
  }
</DashboardShell>
