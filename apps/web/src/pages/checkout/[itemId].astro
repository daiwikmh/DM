---
import DashboardShell from '../../layouts/DashboardShell.astro';
import { db, items, shares, users, checkouts } from '@prava/db';
import { createSession } from '@prava/worker/payments/prava';
import { eq } from 'drizzle-orm';

const { userId } = Astro.locals;
if (!userId) return Astro.redirect('/');

const { itemId } = Astro.params;

const [row] = await db
  .select({ item: items, share: shares })
  .from(items)
  .innerJoin(shares, eq(items.shareId, shares.id))
  .where(eq(items.id, itemId!))
  .limit(1);

if (!row || row.share.userId !== userId) return new Response('Not found', { status: 404 });

const [user] = await db.select().from(users).where(eq(users.id, userId)).limit(1);

const { item } = row;

// Prava prices a session in a real currency; a candidate without one cannot be
// charged, and an account without an email cannot receive the passkey prompt.
let error: string | null = null;
let session: Awaited<ReturnType<typeof createSession>> | null = null;

if (!item.priceAmount || !item.currency) {
  error = 'This match has no price, so it cannot be checked out.';
} else if (!user?.email) {
  error = 'Your account has no email address, which Prava requires to open a session.';
} else {
  try {
    session = await createSession({
      userId,
      userEmail: user.email,
      totalAmount: item.priceAmount,
      currency: item.currency,
      merchant: {
        name: item.merchant ?? 'Unknown merchant',
        url: item.productUrl,
        countryCodeIso2: 'IN',
      },
      products: [
        {
          description: item.title,
          unitPrice: item.priceAmount,
          quantity: 1,
          productId: item.catalogProductId ?? undefined,
        },
      ],
    });

    // Recorded before the user touches the iframe: without a local row, a
    // session id is unverifiable and any signed-in user could poll or settle
    // someone else's checkout.
    await db.insert(checkouts).values({
      userId,
      itemId: item.id,
      sessionId: session.sessionId,
      orderId: session.orderId,
      totalAmount: item.priceAmount,
      currency: item.currency,
      merchantUrl: item.productUrl,
    });
  } catch (err) {
    error = err instanceof Error ? err.message : String(err);
  }
}
---

<DashboardShell title="Checkout" active="checkouts">
  <header class="mb-6">
    <h1 class="text-2xl font-semibold tracking-tight">Checkout</h1>
    <p class="mt-1 text-sm text-stone-500">
      {item.title}{item.merchant && ` · ${item.merchant}`}
    </p>
  </header>

  {
    error && (
      <div class="rounded-xl border border-red-200 bg-red-50 p-6">
        <p class="font-medium text-red-900">Could not start checkout</p>
        <p class="mt-1 text-sm text-red-700">{error}</p>
      </div>
    )
  }

  {
    session && (
      <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]">
        <iframe
          src={session.iframeUrl}
          title="Prava payment authorization"
          class="h-[38rem] w-full rounded-xl border border-stone-200 bg-white"
          allow="publickey-credentials-get *; payment *"
        />

        <aside class="rounded-xl border border-stone-200 bg-white p-4">
          <p class="text-sm font-medium">Authorize with your passkey</p>
          <p class="mt-1 text-xs text-stone-500">
            Prava mints one-time card credentials once you approve. Nothing is charged here.
          </p>

          <dl class="mt-4 space-y-1 text-xs text-stone-500">
            <div class="flex justify-between">
              <dt>Order</dt>
              <dd class="font-mono">{session.orderId}</dd>
            </div>
            <div class="flex justify-between">
              <dt>Amount</dt>
              <dd>{item.priceAmount} {item.currency}</dd>
            </div>
          </dl>

          <p
            id="status"
            data-session={session.sessionId}
            class="mt-4 rounded-lg bg-stone-100 px-3 py-2 text-sm"
          >
            Waiting for authorization…
          </p>

          {/*
            Prava mints credentials; it never places the order. With no
            merchant-execution layer, the card is handed to the user to
            complete the purchase at the merchant themselves.
          */}
          <div id="card" hidden class="mt-4 rounded-lg border border-stone-200 p-3">
            <p class="text-xs font-medium tracking-wide text-stone-500 uppercase">
              One-time card
            </p>
            <dl class="mt-2 space-y-1 font-mono text-sm">
              <div class="flex justify-between"><dt class="text-stone-500">Number</dt><dd id="card-token" /></div>
              <div class="flex justify-between"><dt class="text-stone-500">CVV</dt><dd id="card-cvv" /></div>
              <div class="flex justify-between"><dt class="text-stone-500">Expiry</dt><dd id="card-exp" /></div>
            </dl>
            <a
              href={item.productUrl}
              target="_blank"
              rel="noopener nofollow"
              class="mt-3 block rounded-lg bg-stone-900 px-4 py-2 text-center text-sm font-medium text-white hover:bg-stone-700"
            >
              Complete at {item.merchant ?? 'merchant'}
            </a>

            <form id="ship" class="mt-4 grid grid-cols-2 gap-2" data-item={item.id}>
              <p class="col-span-2 text-xs font-medium tracking-wide text-stone-500 uppercase">
                Ship to
              </p>
              <input name="email" type="email" required value={user?.email ?? ''} placeholder="Email" class="col-span-2 rounded border border-stone-300 px-2 py-1 text-xs" />
              <input name="firstName" required placeholder="First name" class="rounded border border-stone-300 px-2 py-1 text-xs" />
              <input name="lastName" required placeholder="Last name" class="rounded border border-stone-300 px-2 py-1 text-xs" />
              <input name="address1" required placeholder="Address" class="col-span-2 rounded border border-stone-300 px-2 py-1 text-xs" />
              <input name="city" required placeholder="City" class="rounded border border-stone-300 px-2 py-1 text-xs" />
              <input name="postalCode" required placeholder="PIN code" class="rounded border border-stone-300 px-2 py-1 text-xs" />
              <input name="province" placeholder="State" class="rounded border border-stone-300 px-2 py-1 text-xs" />
              <input name="phone" placeholder="Phone" class="rounded border border-stone-300 px-2 py-1 text-xs" />
              <input name="countryCode" required value="IN" class="rounded border border-stone-300 px-2 py-1 text-xs" />

              <button
                type="submit"
                class="col-span-2 mt-1 rounded-lg bg-stone-900 px-4 py-2 text-sm font-medium text-white hover:bg-stone-700"
              >
                Buy it for me
              </button>
            </form>

            <p id="order" class="mt-3 text-xs text-stone-500" />

            <details class="mt-3">
              <summary class="cursor-pointer text-xs text-stone-500">Settle manually instead</summary>
              <div class="mt-2 flex gap-2">
                <button
                  data-settle="APPROVED"
                  class="flex-1 rounded-lg border border-stone-300 px-3 py-1.5 text-xs font-medium hover:bg-stone-50"
                >
                  It worked
                </button>
                <button
                  data-settle="DECLINED"
                  class="flex-1 rounded-lg border border-stone-300 px-3 py-1.5 text-xs font-medium hover:bg-stone-50"
                >
                  It failed
                </button>
              </div>
            </details>
          </div>
        </aside>
      </div>
    )
  }
</DashboardShell>

<script>
  const status = document.getElementById('status');
  const sessionId = status?.dataset.session;

  if (status && sessionId) {
    const poll = async () => {
      const res = await fetch(`/api/payment-result/${sessionId}`);
      const body = await res.json();

      // Credentials land at 'awaiting_result'; 'completed' only happens after
      // the outcome is reported, so waiting for it would hang here forever.
      if (body.credentials) {
        status.textContent = 'Authorized — payment credentials minted.';
        status.className = 'mt-4 rounded-lg bg-green-100 px-3 py-2 text-sm text-green-900';

        const card = document.getElementById('card');
        if (card) {
          document.getElementById('card-token')!.textContent = body.credentials.token;
          document.getElementById('card-cvv')!.textContent = body.credentials.dynamicCvv;
          document.getElementById('card-exp')!.textContent =
            `${body.credentials.expiryMonth}/${body.credentials.expiryYear}`;
          card.hidden = false;

          const form = document.getElementById('ship') as HTMLFormElement | null;
          const order = document.getElementById('order');

          form?.addEventListener('submit', async (event) => {
            event.preventDefault();
            if (!order) return;

            order.textContent = 'Driving the merchant checkout…';
            const shipping = Object.fromEntries(new FormData(form).entries());

            const res = await fetch(`/api/place-order/${sessionId}`, {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ itemId: form.dataset.item, shipping }),
            });
            const result = await res.json();

            // A decline is the merchant's verdict on a real card — the chain ran.
            order.textContent =
              result.status === 'placed'
                ? `Order placed. ${result.url ?? ''}`
                : result.status === 'declined'
                  ? `Declined at the merchant: ${result.message} — reported to Prava.`
                  : `Could not complete: ${result.message}`;
          });

          const txnRefId = body.credentials.txnRefId;
          for (const button of card.querySelectorAll<HTMLButtonElement>('[data-settle]')) {
            button.addEventListener('click', async () => {
              const res = await fetch(`/api/report-status/${sessionId}`, {
                method: 'POST',
                headers: { 'content-type': 'application/json' },
                body: JSON.stringify({ txnRefId, status: button.dataset.settle }),
              });
              const settled = await res.json();
              status.textContent = settled.ok
                ? `Reported to Prava as ${button.dataset.settle}.`
                : `Could not report: ${settled.message}`;
            });
          }
        }
        return;
      }

      if (body.status === 'failed') {
        status.textContent = body.error?.message ?? 'Authorization failed.';
        status.className = 'mt-4 rounded-lg bg-red-100 px-3 py-2 text-sm text-red-900';
        return;
      }

      setTimeout(poll, 2000);
    };

    void poll();
  }
</script>
