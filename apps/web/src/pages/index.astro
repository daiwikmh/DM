---
import '../styles/global.css';
import { LandingExperience } from '../components/landing/LandingExperience.tsx';

if (Astro.locals.userId) return Astro.redirect('/dashboard');

const isDev = import.meta.env.DEV;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>FOUND — send a reel, get the product</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="m-0">
    <LandingExperience client:only="react" />

    {
      /* Dev-only auth stub — separate from the spec'd CTA so the real "start"
         button can point at the real destination without this getting in the way. */
      isDev && (
        <form
          method="POST"
          action="/dev-login"
          class="fixed bottom-4 left-4 z-[60] flex gap-2 rounded-lg bg-stone-900 p-2"
        >
          <input
            type="email"
            name="email"
            required
            placeholder="you@example.com"
            class="rounded bg-white px-2 py-1 text-xs text-stone-900"
          />
          <button type="submit" class="rounded bg-white px-2 py-1 text-xs font-medium text-stone-900">
            Dev sign in
          </button>
        </form>
      )
    }
  </body>
</html>
