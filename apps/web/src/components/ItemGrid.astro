---
import { db, shares, items } from '@prava/db';
import { eq, desc, inArray, asc } from 'drizzle-orm';
import ShareCard from './ShareCard.astro';

interface Props {
  userId: string;
}

const { userId } = Astro.props;

const userShares = await db
  .select()
  .from(shares)
  .where(eq(shares.userId, userId))
  .orderBy(desc(shares.createdAt))
  .limit(60);

const shareItems = userShares.length
  ? await db
      .select()
      .from(items)
      .where(
        inArray(
          items.shareId,
          userShares.map((s) => s.id),
        ),
      )
      .orderBy(asc(items.rank))
  : [];

const byShare = Map.groupBy(shareItems, (item) => item.shareId);
---

{
  userShares.length === 0 ? (
    <div class="border border-dashed border-white/15 px-6 py-16 text-center">
      <p class="text-[20px] font-medium tracking-[-0.04em] sm:text-[30px]">Nothing here yet</p>
      <p class="mx-auto mt-3 max-w-sm text-[13px] leading-relaxed text-white/40 sm:text-[15px]">
        Send a reel to your Instagram or WhatsApp and it will show up here.
      </p>
    </div>
  ) : (
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {userShares.map((share) => (
        <ShareCard share={share} items={byShare.get(share.id) ?? []} />
      ))}
    </div>
  )
}
